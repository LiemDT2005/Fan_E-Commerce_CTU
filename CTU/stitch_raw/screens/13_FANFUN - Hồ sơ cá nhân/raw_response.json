y-0 peer-checked:opacity-100 transition-opacity\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cspan class=\"font-body-md text-body-md text-on-surface peer-checked:font-bold\"\u003eNữ\u003c/span\u003e\n\u003c/label\u003e\n\u003clabel class=\"flex items-center gap-space-xs cursor-pointer select-none\"\u003e\n\u003cinput class=\"hidden peer\" name=\"gender\" type=\"radio\" value=\"khac\"/\u003e\n\u003cdiv class=\"w-5 h-5 rounded-full bg-surface-container flex items-center justify-center peer-checked:bg-primary transition-colors\"\u003e\n\u003cdiv class=\"w-2 h-2 rounded-full bg-white opacity-0 peer-checked:opacity-100 transition-opacity\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cspan class=\"font-body-md text-body-md text-on-surface peer-checked:font-bold\"\u003eKhác\u003c/span\u003e\n\u003c/label\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Ecosystem Sync Notice --\u003e\n\u003cdiv class=\"p-space-md rounded-xl bg-surface-container flex items-start gap-space-sm\"\u003e\n\u003cspan class=\"material-symbols-outlined text-primary text-[20px] mt-0.5\"\u003esync\u003c/span\u003e\n\u003cdiv class=\"flex flex-col\"\u003e\n\u003cspan class=\"font-label-md text-label-md font-bold text-on-surface\"\u003eĐồng bộ ứng dụng di động FANFUN Home\u003c/span\u003e\n\u003cspan class=\"font-body-sm text-body-sm text-on-surface-variant leading-relaxed\"\u003e\n              Mọi chỉnh sửa tại đây sẽ tức thì đồng bộ hóa với hệ điều hành quạt trần 3-in-1, ứng dụng di động và hệ thống kích hoạt thợ kỹ thuật số FANFUN Service.\n            \u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Form Actions --\u003e\n\u003cdiv class=\"flex items-center justify-end gap-space-md pt-space-md\"\u003e\n\u003cbutton class=\"px-space-lg py-space-sm rounded-xl font-label-lg text-label-lg text-on-surface-variant hover:bg-surface-container-high transition-colors\" onclick=\"resetFormState()\" type=\"reset\"\u003e\n            Hủy\n          \u003c/button\u003e\n\u003cbutton class=\"px-space-xl py-space-sm rounded-xl bg-primary text-on-primary font-label-lg text-label-lg font-bold shadow hover:bg-primary-container active:scale-95 transition-all flex items-center gap-space-xs\" id=\"submitBtn\" type=\"submit\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px]\"\u003esave\u003c/span\u003e\n\u003cspan id=\"btnText\"\u003eLưu thay đổi\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c/form\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cscript\u003e\n  function triggerToast() {\n    const toast = document.getElementById('saveToast');\n    toast.classList.remove('hidden');\n    setTimeout(() =\u003e {\n      toast.classList.remove('opacity-0', '-translate-y-2');\n      toast.classList.add('opacity-100', 'translate-y-0');\n    }, 20);\n\n    setTimeout(() =\u003e {\n      dismissToast();\n    }, 4000);\n  }\n\n  function dismissToast() {\n    const toast = document.getElementById('saveToast');\n    toast.classList.add('opacity-0', '-translate-y-2');\n    toast.classList.remove('opacity-100', 'translate-y-0');\n    setTimeout(() =\u003e {\n      toast.classList.add('hidden');\n    }, 300);\n  }\n\n  function toggleErrorState() {\n    const nameInput = document.getElementById('fullName');\n    const nameError = document.getElementById('nameError');\n    if (nameError.classList.contains('hidden')) {\n      nameError.classList.remove('hidden');\n      nameInput.classList.add('ring-2', 'ring-error', 'bg-error-container/20');\n      nameInput.value = '';\n    } else {\n      nameError.classList.add('hidden');\n      nameInput.classList.remove('ring-2', 'ring-error', 'bg-error-container/20');\n      nameInput.value = 'Nguyễn Văn An';\n    }\n  }\n\n  function simulateLoading() {\n    const btn = document.getElementById('submitBtn');\n    const text = document.getElementById('btnText');\n    btn.disabled = true;\n    text.innerText = 'Đang xử lý...';\n    btn.classList.add('opacity-70');\n\n    setTimeout(() =\u003e {\n      btn.disabled = false;\n      text.innerText = 'Lưu thay đổi';\n      btn.classList.remove('opacity-70');\n      triggerToast();\n    }, 1200);\n  }\n\n  function resetFormState() {\n    const nameError = document.getElementById('nameError');\n    const nameInput = document.getElementById('fullName');\n    nameError.classList.add('hidden');\n    nameInput.classList.remove('ring-2', 'ring-error', 'bg-error-container/20');\n    nameInput.value = 'Nguyễn Văn An';\n  }\n\u003c/script\u003e\u003c/main\u003e\u003cfooter class=\"w-full bg-surface-container-low py-space-xl\"\u003e\u003cdiv class=\"w-full px-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter\"\u003e\u003cdiv class=\"flex flex-col gap-space-sm\"\u003e\u003cdiv class=\"flex items-center gap-space-xs\"\u003e\u003cspan class=\"font-headline-sm text-headline-sm font-bold text-primary\"\u003eFANFUN\u003c/span\u003e\u003cspan class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider pl-1\"\u003eSmart Living\u003c/span\u003e\u003c/div\u003e\u003cp class=\"font-body-sm text-body-sm text-on-surface-variant leading-relaxed\"\u003eThoải mái quanh năm, thông minh mỗi ngày. Tiên phong giải pháp làm mát, thanh lọc không khí và chiếu sáng thông minh cho tổ ấm Việt Nam.\u003c/p\u003e\u003cp class=\"font-label-sm text-label-sm text-outline mt-space-sm\"\u003e© 2024 FANFUN Việt Nam. All rights reserved.\u003c/p\u003e\u003c/div\u003e\u003cdiv class=\"flex flex-col gap-space-sm\"\u003e\u003cspan class=\"font-label-lg text-label-lg font-bold text-on-surface\"\u003eSản phẩm\u003c/span\u003e\u003cdiv class=\"flex flex-col gap-space-xs\"\u003e\u003ca class=\"font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors\" data-path=\"san-pham-he-sinh-thai\" href=\"#\"\u003eQuạt Trần Thông Minh 3-in-1\u003c/a\u003e\u003ca class=\"font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors\" data-path=\"san-pham-he-sinh-thai\" href=\"#\"\u003eQuạt Đứng Tuần Hoàn Khí\u003c/a\u003e\u003ca class=\"font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors\" data-path=\"san-pham-he-sinh-thai\" href=\"#\"\u003eLõi Lọc HEPA H13 Khử Khuẩn\u003c/a\u003e\u003ca class=\"font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors\" data-path=\"san-pham-he-sinh-thai\" href=\"#\"\u003ePhụ Kiện &amp; Cảm Biến Môi Trường\u003c/a\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"flex flex-col gap-space-sm\"\u003e\u003cspan class=\"font-label-lg text-label-lg font-bold text-on-surface\"\u003eHỗ trợ khách hàng\u003c/span\u003e\u003cdiv class=\"flex flex-col gap-space-xs\"\u003e\u003ca class=\"font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors\" data-path=\"dich-vu-lap-dat-bao-hanh\" href=\"#\"\u003eChính sách lắp đặt chuẩn 4.0\u003c/a\u003e\u003ca class=\"font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors\" data-path=\"dich-vu-lap-dat-bao-hanh\" href=\"#\"\u003eBảo hành điện tử 36 tháng\u003c/a\u003e\u003ca class=\"font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors\" data-path=\"dich-vu-lap-dat-bao-hanh\" href=\"#\"\u003eHướng dẫn cài đặt ứng dụng FANFUN\u003c/a\u003e\u003ca class=\"font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors\" data-path=\"cau-chuyen-thuong-hieu\" href=\"#\"\u003eHệ thống Showroom toàn quốc\u003c/a\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"flex flex-col gap-space-sm\"\u003e\u003cspan class=\"font-label-lg text-label-lg font-bold text-on-surface\"\u003eLiên hệ &amp; Trụ sở\u003c/span\u003e\u003cdiv class=\"flex flex-col gap-space-xs text-on-surface-variant font-body-sm text-body-sm\"\u003e\u003cdiv class=\"flex items-start gap-space-xs\"\u003e\u003cspan class=\"material-symbols-outlined text-[18px] text-primary mt-0.5\"\u003elocation_on\u003c/span\u003e