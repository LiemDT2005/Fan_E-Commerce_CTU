003e\n\u003cnav aria-label=\"Breadcrumb\" class=\"flex items-center gap-space-xs text-on-surface-variant font-label-md text-label-md mb-space-md\"\u003e\n\u003ca class=\"hover:text-primary transition-colors\" href=\"#\"\u003eTrang chủ\u003c/a\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px] text-outline\"\u003echevron_right\u003c/span\u003e\n\u003ca class=\"hover:text-primary transition-colors\" href=\"#\"\u003eGiỏ hàng\u003c/a\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px] text-outline\"\u003echevron_right\u003c/span\u003e\n\u003cspan class=\"text-on-surface font-semibold\"\u003eThanh toán\u003c/span\u003e\n\u003c/nav\u003e\n\u003c!-- Step Indicator Bar --\u003e\n\u003cdiv class=\"flex flex-col md:flex-row md:items-center justify-between gap-space-md py-space-sm\"\u003e\n\u003cdiv class=\"flex flex-col\"\u003e\n\u003cspan class=\"text-primary font-label-sm text-label-sm uppercase tracking-widest font-semibold\"\u003eQuy trình mua sắm an tâm\u003c/span\u003e\n\u003ch1 class=\"font-headline-md text-headline-md text-on-surface mt-space-xs\"\u003eThanh toán &amp; Lịch lắp đặt tận nhà\u003c/h1\u003e\n\u003c/div\u003e\n\u003c!-- Visual Step Counter --\u003e\n\u003cdiv class=\"flex items-center gap-space-sm bg-surface p-space-xs rounded-full shadow-sm\"\u003e\n\u003c!-- Step 1 Done --\u003e\n\u003cdiv class=\"flex items-center gap-space-xs px-space-md py-1.5 rounded-full bg-surface-container text-on-surface-variant\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px] text-primary\" style=\"font-variation-settings: 'FILL' 1;\"\u003echeck_circle\u003c/span\u003e\n\u003cspan class=\"font-label-md text-label-md\"\u003e1. Giỏ hàng\u003c/span\u003e\n\u003c/div\u003e\n\u003cspan class=\"w-4 h-[2px] bg-outline-variant\"\u003e\u003c/span\u003e\n\u003c!-- Step 2 Active --\u003e\n\u003cdiv class=\"flex items-center gap-space-xs px-space-md py-1.5 rounded-full bg-primary text-on-primary shadow-sm\"\u003e\n\u003cspan class=\"w-5 h-5 rounded-full bg-on-primary text-primary flex items-center justify-center font-label-sm text-label-sm font-bold\"\u003e2\u003c/span\u003e\n\u003cspan class=\"font-label-md text-label-md font-semibold\"\u003eGiao hàng &amp; Thanh toán\u003c/span\u003e\n\u003c/div\u003e\n\u003cspan class=\"w-4 h-[2px] bg-outline-variant\"\u003e\u003c/span\u003e\n\u003c!-- Step 3 Upcoming --\u003e\n\u003cdiv class=\"flex items-center gap-space-xs px-space-md py-1.5 rounded-full text-secondary\"\u003e\n\u003cspan class=\"w-5 h-5 rounded-full bg-surface-container text-secondary flex items-center justify-center font-label-sm text-label-sm\"\u003e3\u003c/span\u003e\n\u003cspan class=\"font-label-md text-label-md\"\u003eHoàn tất\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003c!-- Main Checkout Workflow (Desktop Two-Column Grid) --\u003e\n\u003csection class=\"w-full py-space-xl\"\u003e\n\u003cdiv class=\"max-w-[1280px] mx-auto px-gutter\"\u003e\n\u003cdiv class=\"grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start\"\u003e\n\u003c!-- LEFT COLUMN: Shipping & Customer Form --\u003e\n\u003cdiv class=\"lg:col-span-7 flex flex-col gap-space-lg\"\u003e\n\u003c!-- Authenticated Customer Banner Card --\u003e\n\u003cdiv class=\"bg-surface-container p-space-lg rounded-xl shadow-sm flex items-center justify-between flex-wrap gap-space-md\"\u003e\n\u003cdiv class=\"flex items-center gap-space-md\"\u003e\n\u003cdiv class=\"w-12 h-12 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-sm\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[24px]\"\u003everified_user\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex flex-col\"\u003e\n\u003cdiv class=\"flex items-center gap-space-xs\"\u003e\n\u003cspan class=\"font-headline-sm text-headline-sm text-on-surface\"\u003eNguyễn Văn An\u003c/span\u003e\n\u003cspan class=\"inline-flex items-center px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm font-semibold tracking-wide\"\u003e\n                    FANFUN Club\n                  \u003c/span\u003e\n\u003c/div\u003e\n\u003cspan class=\"font-body-sm text-body-sm text-on-surface-variant\"\u003ean.nguyen@example.com • Điểm tích lũy: +1.029 pts\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003ca class=\"font-label-md text-label-md text-primary hover:underline flex items-center gap-1\" href=\"#\"\u003e\n              Đổi tài khoản\n              \u003cspan class=\"material-symbols-outlined text-[16px]\"\u003esync_alt\u003c/span\u003e\n\u003c/a\u003e\n\u003c/div\u003e\n\u003c!-- Recipient Shipping Address Form Block --\u003e\n\u003cdiv class=\"bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl shadow-sm flex flex-col gap-space-lg\"\u003e\n\u003cdiv class=\"flex items-center justify-between pb-space-xs\"\u003e\n\u003cdiv class=\"flex items-center gap-space-sm\"\u003e\n\u003cspan class=\"material-symbols-outlined text-primary text-[24px]\"\u003elocal_shipping\u003c/span\u003e\n\u003ch2 class=\"font-headline-sm text-headline-sm text-on-surface\"\u003eThông tin nhận hàng &amp; Khảo sát\u003c/h2\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm\"\u003e\n\u003cspan class=\"w-2 h-2 rounded-full bg-[#1b8040]\"\u003e\u003c/span\u003e\n                Đã điền hợp lệ\n              \u003c/div\u003e\n\u003c/div\u003e\n\u003cform class=\"flex flex-col gap-space-md\" id=\"checkout-form\" onsubmit=\"event.preventDefault(); simulateOrderProcessing();\"\u003e\n\u003c!-- Name & Phone Fields --\u003e\n\u003cdiv class=\"grid grid-cols-1 md:grid-cols-2 gap-space-md\"\u003e\n\u003c!-- Recipient Name --\u003e\n\u003cdiv class=\"flex flex-col gap-1.5\"\u003e\n\u003cdiv class=\"flex items-center justify-between\"\u003e\n\u003clabel class=\"font-label-md text-label-md text-on-surface font-semibold\" for=\"recipient-