uppercase mt-space-xs\"\u003eSmart Living\u003c/span\u003e\u003c/a\u003e\u003c/div\u003e\u003cnav class=\"hidden xl:flex items-center gap-space-xs\" data-active-classes=\"bg-primary-container text-on-primary-container font-semibold rounded-lg shadow-sm\"\u003e\u003ca class=\"px-space-md py-space-sm font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all\" data-path=\"trang-chu\" href=\"#\"\u003eTrang chủ\u003c/a\u003e\u003ca class=\"px-space-md py-space-sm font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all\" data-path=\"san-pham-he-sinh-thai\" href=\"#\"\u003eSản phẩm &amp; Hệ sinh thái\u003c/a\u003e\u003ca class=\"px-space-md py-space-sm font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all\" data-path=\"cong-nghe-3-in-1\" href=\"#\"\u003eCông nghệ 3-in-1\u003c/a\u003e\u003ca class=\"px-space-md py-space-sm font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all\" data-path=\"dich-vu-lap-dat-bao-hanh\" href=\"#\"\u003eDịch vụ lắp đặt &amp; Bảo hành\u003c/a\u003e\u003ca class=\"px-space-md py-space-sm font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all\" data-path=\"cau-chuyen-thuong-hieu\" href=\"#\"\u003eCâu chuyện thương hiệu\u003c/a\u003e\u003c/nav\u003e\u003cdiv class=\"flex items-center gap-space-md\"\u003e\u003cbutton aria-label=\"Tìm kiếm\" class=\"p-space-xs rounded-full text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all flex items-center justify-center\"\u003e\u003cspan class=\"material-symbols-outlined text-[22px]\"\u003esearch\u003c/span\u003e\u003c/button\u003e\u003ca class=\"hidden md:flex items-center gap-space-xs px-space-md py-space-sm rounded-full bg-surface-container-low hover:bg-surface-container transition-colors text-on-surface\" href=\"tel:19006868\"\u003e\u003cspan class=\"material-symbols-outlined text-primary text-[18px]\"\u003ecall\u003c/span\u003e\u003cspan class=\"font-label-md text-label-md text-on-surface\"\u003e1900 6868\u003c/span\u003e\u003c/a\u003e\u003ca aria-label=\"Tài khoản\" class=\"hidden sm:flex items-center gap-space-xs text-on-surface-variant hover:text-on-surface font-label-md text-label-md transition-colors\" data-path=\"tai-khoan\" href=\"#\"\u003e\u003cdiv class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"\u003e\u003cspan class=\"material-symbols-outlined text-on-primary text-[18px]\"\u003eperson\u003c/span\u003e\u003c/div\u003e\u003cspan class=\"hidden lg:inline\"\u003eTài khoản\u003c/span\u003e\u003c/a\u003e\u003ca aria-label=\"Giỏ hàng\" class=\"relative p-space-xs rounded-full text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all flex items-center justify-center\" data-path=\"cart\" href=\"#\"\u003e\u003cspan class=\"material-symbols-outlined text-[24px]\"\u003eshopping_bag\u003c/span\u003e\u003cspan class=\"absolute -top-1 -right-1 min-w-[20px] h-[20px] px-1 rounded-full bg-primary text-on-primary font-label-sm text-label-sm flex items-center justify-center leading-none ring-2 ring-surface\"\u003e2\u003c/span\u003e\u003c/a\u003e\u003cbutton aria-label=\"Menu điều hướng\" class=\"xl:hidden p-space-xs rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors\"\u003e\u003cspan class=\"material-symbols-outlined text-[26px]\"\u003emenu\u003c/span\u003e\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\u003c/header\u003e\u003cmain class=\"w-full pt-20 bg-surface min-h-[calc(100vh-80px)]\"\u003e\u003cdiv class=\"flex flex-col w-full\"\u003e\n\u003c!-- Subtle decorative ambient backdrop --\u003e\n\u003cdiv class=\"relative w-full overflow-hidden pb-space-xl\"\u003e\n\u003cdiv class=\"absolute -top-40 left-1/2 -translate-x-1/2 w-[720px] h-[360px] bg-gradient-to-b from-primary/10 via-primary-fixed/30 to-transparent blur-3xl pointer-events-none rounded-full\"\u003e\u003c/div\u003e\n\u003cdiv class=\"max-w-[1120px] mx-auto px-gutter relative z-10\"\u003e\n\u003c!-- Breadcrumb indicator --\u003e\n\u003cdiv class=\"py-space-md flex items-center justify-center gap-space-sm text-on-surface-variant font-label-md text-label-md\"\u003e\n\u003cspan class=\"flex items-center gap-1 text-primary\"\u003e\u003cspan class=\"material-symbols-outlined text-[16px]\"\u003echeck_circle\u003c/span\u003e 1. Giỏ hàng\u003c/span\u003e\n\u003cspan class=\"text-outline-variant font-body-sm\"\u003e/\u003c/span\u003e\n\u003cspan class=\"flex items-center gap-1 text-primary\"\u003e\u003cspan class=\"material-symbols-outlined text-[16px]\"\u003echeck_circle\u003c/span\u003e 2. Khảo sát &amp; Thanh toán\u003c/span\u003e\n\u003cspan class=\"text-outline-variant font-body-sm\"\u003e/\u003c/span\u003e\n\u003cspan class=\"flex items-center gap-1 text-primary font-bold\"\u003e\u003cspan class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\"\u003etask_alt\u003c/span\u003e 3. Hoàn tất đặt hàng\u003c/span\u003e\n\u003c/div\u003e\n\u003c!-- Hero Confirmation Block --\u003e\n\u003cdiv class=\"text-center pt-space-md pb-space-lg flex flex-col items-center max-w-2xl mx-auto\"\u003e\n\u003c!-- Animated Success Badge --\u003e\n\u003cdiv class=\"relative mb-space-md\"\u003e\n\u003cdiv class=\"w-20 h-20 rounded-full bg-surface-container-high flex items-center justify-center shadow-sm\"\u003e\n\u003cdiv class=\"w-14 h-14 rounded-full bg-primary flex items-center justify-center text-on-primary shadow-md\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[32px]\" style=\"font-variation-settings: 'FILL' 1;\"\u003echeck\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"absolute -bottom-1 -right-1 bg-surface-container-lowest text-primary rounded-full p-1 shadow-sm flex items-center justify-center\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px]\"\u003everified\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cspan class=\"inline-flex items-center gap-1 px-space-md py-1 rounded-full bg-surface-container-high text-primary font-label-md text-label-md uppercase tracking-wider mb-space-sm\"\u003e\n          Giao dịch được chứng thực\n        \u003c/span\u003e\n\u003ch1 class=\"font-headline-lg text-headline-lg text-on-surface mb-space-sm\"\u003e\n          Đặt hàng thành công!\n        \u003c/h1\u003e\n\u003cp class=\"font-body-md text-body-md text-on-surface-variant max-w-xl leading-relaxed\"\u003e\n          Cảm ơn quý khách \u003cspan class=\"font-semibold text-on-surface\"\u003eNguyễn Văn An\u003c/span\u003e. Đơn hàng của quý khách đã được tiếp nhận và kỹ thuật viên FANFUN sẽ liên hệ xác nhận trong vòng \u003cspan class=\"text-primary font-semibold\"\u003e15-30 phút\u003c/span\u003e để chốt lịch khảo sát &amp; lắp đặt.\n        \u003c/p\u003e\n\u003c!-- Order Pill & Copy Feature --\u003e\n\u003cdiv class=\"mt-space-md flex flex-wrap items-center justify-center gap-space-sm bg-surface-container-lowest px-space-md py-space-sm rounded-xl shadow-sm\"\u003e\n\u003cdiv class=\"flex items-center gap-2\"\u003e\n\u003cspan class=\"font-label-md text-label-md text-on-surface-variant uppercase\"\u003eMã đơn hàng:\u003c/span\u003e\n\u003cspan class=\"font-headline-sm text-headline-sm font-bold text-primary tracking-wide\" id=\"orderIdText\"\u003e#FF-2025-8869\u003c/span\u003e\n\u003c/div\u003e\n\u003cbutton class=\"flex items-center gap-1 px-space-sm py-1 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-label-md text-label-md transition-all active:scale-95\" id=\"copyBtn\" onclick=\"navigator.clipboard.writeText('#FF-2025-8869'); const t = document.getElementById('copyBtnText'); t.innerText='Đã chép!'; setTimeout(()=&gt;t.innerText='Sao chép', 2000);\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px]\"\u003econtent_copy\u003c/span\u003e\n\u003cspan id=\"copyBtnText\"\u003eSao chép\u003c/span\u003e\n\u003c/button\u003e\n\u003cspan class=\"inline-block w-1.5 h-1.5 rounded-full bg-outline-variant mx-1\"\u003e\u003c/span\u003e\n\u003cspan class=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed-variant font-label-sm text-label-sm font-semibold\"\u003e\n\u003cspan class=\"w-1.5 h-1.5 rounded-full bg-primary animate-pulse\"\u003e\u003c/span\u003e\n            Đã tiếp nhận - Chờ liên hệ khảo sát\n          \u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Main Content Grid --\u003e\n\u003cdiv class=\"grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start\"\u003e\n\u003c!-- Left Column: Order Summary & Item list (7 cols) --\u003e\n\u003cdiv class=\"lg:col-span-7 flex flex-col gap-space-lg\"\u003e\n\u003c!-- Order Items Card --\u003e\n\u003cdiv class=\"bg-surface-container-lowest rounded-xl p-space-lg shadow-sm\"\u003e\n\u003cdiv class=\"flex items-center justify-between pb-space-md\"\u003e\n\u003cdiv class=\"flex items-center gap-space-sm\"\u003e\n\u003cspan class=\"w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-primary\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[20px]\"\u003einventory_2\u003c/span\u003e\n\u003c/span\u003e\n\u003ch2 class=\"font-headline-sm text-headline-sm text-on-surface\"\u003eChi tiết đơn hàng\u003c/h2\u003e\n\u003c/div\u003e\n\u003cspan class=\"font-label-md text-label-md text-on-surface-variant\"\u003e2 danh mục (3 sản phẩm)\u003c/span\u003e\n\u003c/div\u003e\n\u003c!-- Products List --\u003e\n\u003cdiv class=\"flex flex-col gap-space-md pt-space-xs\"\u003e\n\u003c!-- Item 1 --\u003e\n\u003cdiv class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-md p-space-md rounded-lg bg-surface-container-low hover:bg-surface-container transition-colors\"\u003e\n\u003cdiv class=\"flex items-ce