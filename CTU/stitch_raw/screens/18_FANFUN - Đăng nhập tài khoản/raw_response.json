{
  "dataString": "\u003c!DOCTYPE html\u003e\u003chtml lang=\"vi\"\u003e\u003chead\u003e\u003cmeta charset=\"utf-8\"\u003e\u003cmeta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"\u003e\u003cmeta content=\"web_blank\" name=\"shell-type\"\u003e\u003clink href=\"https://fonts.googleapis.com\" rel=\"preconnect\"\u003e\u003clink crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"\u003e\u003clink href=\"https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\"\u003e\u003clink href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"\u003e\u003cstyle\u003e@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main\u003e:first-child{margin-top:0!important;}main\u003e:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}\u003c/style\u003e\u003cscript src=\"https://cdn.tailwindcss.com\"\u003e\u003c/script\u003e\u003cscript id=\"tailwind-config\"\u003etailwind.config={darkMode:\"class\",theme:{extend:{colors:{\"surface-variant\":\"#eae1d6\",\"on-primary-container\":\"#fffbff\",\"inverse-surface\":\"#343028\",\"on-surface\":\"#1f1b14\",\"on-primary\":\"#ffffff\",\"surface\":\"#fff8f2\",\"inverse-on-surface\":\"#f9efe4\",\"on-tertiary-fixed\":\"#1d1b15\",\"surface-container-highest\":\"#eae1d6\",\"on-secondary\":\"#ffffff\",\"on-secondary-container\":\"#656464\",\"error\":\"#ba1a1a\",\"background\":\"#fff8f2\",\"primary\":\"#9c3f11\",\"secondary\":\"#5f5e5e\",\"on-tertiary-fixed-variant\":\"#49473f\",\"tertiary\":\"#5f5c53\",\"tertiary-fixed-dim\":\"#cbc6bc\",\"on-surface-variant\":\"#56423b\",\"on-tertiary-container\":\"#fffbff\",\"on-tertiary\":\"#ffffff\",\"on-secondary-fixed-variant\":\"#474746\",\"on-primary-fixed-variant\":\"#7e2c00\",\"surface-container-lowest\":\"#ffffff\",\"on-secondary-fixed\":\"#1b1c1c\",\"error-container\":\"#ffdad6\",\"secondary-fixed\":\"#e4e2e1\",\"outline\":\"#8a7269\",\"surface-container-high\":\"#f0e7db\",\"surface-tint\":\"#9f4113\",\"tertiary-container\":\"#78746b\",\"on-primary-fixed\":\"#370e00\",\"outline-variant\":\"#ddc1b6\",\"primary-fixed-dim\":\"#ffb598\",\"primary-container\":\"#bc5728\",\"on-error\":\"#ffffff\",\"on-background\":\"#1f1b14\",\"surface-container\":\"#f6ede1\",\"surface-container-low\":\"#fcf2e7\",\"primary-fixed\":\"#ffdbce\",\"on-error-container\":\"#93000a\",\"surface-dim\":\"#e2d9ce\",\"surface-bright\":\"#fff8f2\",\"inverse-primary\":\"#ffb598\",\"tertiary-fixed\":\"#e8e2d7\",\"secondary-fixed-dim\":\"#c8c6c5\"},borderRadius:{DEFAULT:\"0.25rem\",lg:\"0.5rem\",xl:\"0.75rem\",full:\"9999px\"},spacing:{\"space-xs\":\"0.25rem\",\"space-lg\":\"1.5rem\",\"space-sm\":\"0.5rem\",\"gutter-mobile\":\"1rem\",gutter:\"1.5rem\",\"space-md\":\"1rem\",\"margin-mobile\":\"1.25rem\",\"space-xl\":\"2.5rem\",margin:\"3rem\"},fontFamily:{\"label-lg\":[\"Be Vietnam Pro\"],\"body-sm\":[\"Be Vietnam Pro\"],\"headline-md\":[\"Be Vietnam Pro\"],\"body-lg\":[\"Be Vietnam Pro\"],\"display-mobile\":[\"Be Vietnam Pro\"],\"label-md\":[\"Be Vietnam Pro\"],\"body-md\":[\"Be Vietnam Pro\"],\"headline-lg\":[\"Be Vietnam Pro\"],\"headline-lg-mobile\":[\"Be Vietnam Pro\"],\"headline-sm\":[\"Be Vietnam Pro\"],\"label-sm\":[\"Be Vietnam Pro\"],display:[\"Be Vietnam Pro\"]},fontSize:{\"label-lg\":[\"0.875rem\",{lineHeight:\"1.25rem\",letterSpacing:\"0.02em\",fontWeight:\"600\"}],\"body-sm\":[\"0.875rem\",{lineHeight:\"1.25rem\",letterSpacing:\"0.005em\",fontWeight:\"400\"}],\"headline-md\":[\"1.5rem\",{lineHeight:\"2rem\",letterSpacing:\"-0.01em\",fontWeight:\"600\"}],\"body-lg\":[\"1.125rem\",{lineHeight:\"1.75rem\",letterSpacing:\"0\",fontWeight:\"400\"}],\"display-mobile\":[\"2.25rem\",{lineHeight:\"2.75rem\",letterSpacing:\"-0.015em\",fontWeight:\"700\"}],\"label-md\":[\"0.75rem\",{lineHeight:\"1rem\",letterSpacing:\"0.04em\",fontWeight:\"600\"}],\"body-md\":[\"1rem\",{lineHeight:\"1.5rem\",letterSpacing:\"0\",fontWeight:\"400\"}],\"headline-lg\":[\"2.25rem\",{lineHeight:\"2.75rem\",letterSpacing:\"-0.015em\",fontWeight:\"600\"}],\"headline-lg-mobile\":[\"1.75rem\",{lineHeight:\"2.25rem\",letterSpacing:\"-0.01em\",fontWeight:\"600\"}],\"headline-sm\":[\"1.25rem\",{lineHeight:\"1.75rem\",letterSpacing:\"0\",fontWeight:\"600\"}],\"label-sm\":[\"0.6875rem\",{lineHeight:\"0.875rem\",letterSpacing:\"0.05em\",fontWeight:\"500\"}],display:[\"3.5rem\",{lineHeight:\"4.25rem\",letterSpacing:\"-0.02em\",fontWeight:\"700\"}]}}}};\u003c/script\u003e\u003c/head\u003e\u003cbody class=\"bg-surface font-body-md text-on-surface antialiased\"\u003e\u003cmain class=\"w-full min-h-screen flex items-center justify-center p-gutter-mobile md:p-gutter\"\u003e\u003cdiv class=\"flex flex-col w-full\"\u003e\n\u003c!-- Desktop 1440px Architecture Container --\u003e\n\u003cdiv class=\"w-full max-w-[1400px] mx-auto my-auto py-4 md:py-8\"\u003e\n\u003cdiv class=\"grid grid-cols-1 lg:grid-cols-12 rounded-xl overflow-hidden bg-surface-container-lowest shadow-xl\"\u003e\n\u003c!-- LEFT COLUMN: Decorative Brand Showcase (~50% width / 6 cols) --\u003e\n\u003cdiv class=\"lg:col-span-6 relative min-h-[580px] lg:min-h-[760px] flex flex-col justify-between p-space-lg lg:p-space-xl overflow-hidden\"\u003e\n\u003c!-- Background Imagery with Living Room Smart Ceiling Fan --\u003e\n\u003cdiv class=\"absolute inset-0 bg-cover bg-center transition-transform duration-1000 scale-105 hover:scale-100\" style=\"background-image: url(&quot;https://lh3.googleusercontent.com/aida-public/AB6AXuA1PDjijiH0dwy8h5BizmPTNe3-JUeLj9TahS4ZjUDoBumRG79jCVNSUZ6udNglbL4In7_Ge_u45ZiaVOV9DceMfqtWz5sUwGWSDVK6RSafx5pMjKBlYF9TkoAspmFA3WdbIhp2yQIQxFFkggEKAPeLA-XrLXwibMDot2bkRMFK7Ag21gzO0vtK7yemYikESo4bJrSnWBACD0kftF8NbOUbOLBYGhJM0_4vT0rlJcs&quot;);\"\u003e\u003c/div\u003e\n\u003c!-- Subtle Natural Gradient Scrim --\u003e\n\u003cdiv class=\"absolute inset-0 bg-gradient-to-t from-on-surface/90 via-on-surface/40 to-transparent\"\u003e\u003c/div\u003e\n\u003cdiv class=\"absolute inset-0 bg-gradient-to-r from-primary-container/20 to-transparent mix-blend-multiply\"\u003e\u003c/div\u003e\n\u003c!-- Top Brand Accent Header --\u003e\n\u003cdiv class=\"relative z-10 flex items-center justify-between\"\u003e\n\u003cdiv class=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-lowest/80 backdrop-blur-md shadow-sm\"\u003e\n\u003cspan class=\"w-2 h-2 rounded-full bg-primary animate-pulse\"\u003e\u003c/span\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-on-surface uppercase tracking-wider\"\u003e\n              Thiết bị gia dụng thông minh Việt Nam\n            \u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-lowest/60 backdrop-blur-md font-label-sm text-label-sm text-on-surface-variant\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px] text-primary\" style=\"font-variation-settings: 'FILL' 1;\"\u003eeco\u003c/span\u003e\n\u003cspan\u003eChuẩn sống tối giản\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Glassmorphism Narrative & Spec Card --\u003e\n\u003cdiv class=\"relative z-10 mt-auto pt-space-xl\"\u003e\n\u003cdiv class=\"p-6 lg:p-8 rounded-xl bg-surface-container-lowest/85 backdrop-blur-md shadow-lg space-y-4\"\u003e\n\u003cdiv class=\"inline-block\"\u003e\n\u003cspan class=\"px-2.5 py-1 rounded bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm tracking-wide\"\u003eQuạt thông minh 5 cánh FANFUN 3-IN-1\u003c/span\u003e\n\u003c/div\u003e\n\u003ch2 class=\"font-headline-lg text-headline-lg text-on-surface leading-tight\"\u003e\n              Thoải mái quanh năm, thông minh mỗi ngày.\n            \u003c/h2\u003e\n\u003cp class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\"\u003e\n              Điều khiển làn gió tự nhiên, ánh sáng đổi màu và làm sạch không khí chỉ với một chạm.\n            \u003c/p\u003e\n\u003c!-- 3 Architectural Specs Chips --\u003e\n\u003cdiv class=\"pt-2 grid grid-cols-1 sm:grid-cols-3 gap-2.5\"\u003e\n\u003cdiv class=\"flex items-center gap-2 p-2.5 rounded-lg bg-surface-container/70\"\u003e\n\u003cspan class=\"material-symbols-outlined text-primary text-[20px]\"\u003emode_fan\u003c/span\u003e\n\u003cdiv class=\"min-w-0\"\u003e\n\u003cp class=\"font-label-sm text-label-sm text-on-surface font-semibold truncate\"\u003eDC Inverter\u003c/p\u003e\n\u003cp class=\"font-label-sm text-label-sm text-secondary truncate\"\u003eÊm dịu 28dB\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex items-center gap-2 p-2.5 rounded-lg bg-surface-container/70\"\u003e\n\u003cspan class=\"material-symbols-outlined text-primary text-[20px]\"\u003elightbulb\u003c/span\u003e\n\u003cdiv class=\"min-w-0\"\u003e\n\u003cp class=\"font-label-sm text-label-sm text-on-surface font-semibold truncate\"\u003e3000lm CCT\u003c/p\u003e\n\u003cp class=\"font-label-sm text-label-sm text-secondary truncate\"\u003eTùy biến ánh sáng\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex items-center gap-2 p-2.5 rounded-lg bg-surface-container/70\"\u003e\n\u003cspan class=\"material-symbols-outlined text-primary text-[20px]\"\u003everified\u003c/span\u003e\n\u003cdiv class=\"min-w-0\"\u003e\n\u003cp class=\"font-label-sm text-label-sm text-on-surface font-semibold truncate\"\u003eTận nhà 5 năm\u003c/p\u003e\n\u003cp class=\"font-label-sm text-label-sm text-secondary truncate\"\u003eBảo hành chính hãng\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- RIGHT COLUMN: Authentication Form (~50% width / 6 cols) --\u003e\n\u003cdiv class=\"lg:col-span-6 flex flex-col justify-between p-space-lg lg:p-space-xl bg-surface-container-low\"\u003e\n\u003cdiv class=\"w-full max-w-md mx-auto space-y-6\"\u003e\n\u003c!-- Brand Logo & Header --\u003e\n\u003cdiv class=\"flex flex-col items-center sm:items-start text-center sm:text-left space-y-3\"\u003e\n\u003cdiv class=\"flex items-center gap-3\"\u003e\n\u003cimg alt=\"FANFUN Logo\" class=\"w-12 h-12 object-contain rounded-lg shadow-sm\" src=\"https://lh3.googleusercontent.com/aida/ALJJyrDMw-su0WMAGsmhG-uh3FUd8u9l-_ORj3SUA_mPhWoQE7QSIZuuDwaqFAxIC_6_nWy3LvEcjK-RVaLpoWJV4G1-qZ1gh76CZmzk1DqHSz4SYxYzYEnFCFEMAVu9VyHsZpOfbcLZV3QCTjL6aiQ30rT44hgBME0IkENoN1ulb4PaLfjM-tgahvzh3TJSr9d1LNzNpZH6hRO45AX2tcmjdiohxzMPoXNuQQ9EJR0sxeZp\"\u003e\n\u003cdiv class=\"flex flex-col text-left\"\u003e\n\u003cspan class=\"font-headline-sm text-headline-sm font-bold text-on-surface tracking-tight\"\u003eFANFUN\u003c/span\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-secondary\"\u003eHệ sinh thái quạt trần cao cấp\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"pt-2\"\u003e\n\u003ch1 class=\"font-headline-lg text-headline-lg text-on-surface\"\u003e\n                Chào mừng trở lại\n              \u003c/h1\u003e\n\u003cp class=\"font-body-md text-body-md text-on-surface-variant mt-1\"\u003e\n                Đăng nhập để quản lý thiết bị FANFUN và theo dõi đơn hàng của bạn.\n              \u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Tab Navigation Switcher --\u003e\n\u003cdiv class=\"p-1 rounded-xl bg-surface-container-highest flex items-center justify-between\"\u003e\n\u003cbutton class=\"w-1/2 py-2 px-4 rounded-lg bg-surface-container-lowest text-on-surface font-label-lg text-label-lg shadow-sm transition-all text-center\" type=\"button\"\u003e\n              Đăng nhập\n            \u003c/button\u003e\n\u003ca class=\"w-1/2 py-2 px-4 rounded-lg text-secondary hover:text-on-surface font-label-lg text-label-lg transition-all text-center\" href=\"#register\"\u003e\n              Đăng ký\n            \u003c/a\u003e\n\u003c/div\u003e\n\u003c!-- Alert Notification Box (Subtle Soft Terracotta) --\u003e\n\u003cdiv class=\"flex items-start gap-3 p-3.5 rounded-lg bg-error-container/40 text-on-error-container shadow-sm transition-all duration-300\" id=\"authAlert\"\u003e\n\u003cspan class=\"material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5\" style=\"font-variation-settings: 'FILL' 1;\"\u003eerror\u003c/span\u003e\n\u003cdiv class=\"flex-1 text-left min-w-0\"\u003e\n\u003cp class=\"font-label-md text-label-md font-semibold text-primary\"\u003eThông báo đăng nhập\u003c/p\u003e\n\u003cp class=\"font-body-sm text-body-sm text-on-surface\"\u003eEmail hoặc mật khẩu không chính xác. Vui lòng kiểm tra lại.\u003c/p\u003e\n\u003c/div\u003e\n\u003cbutton class=\"text-on-surface-variant hover:text-on-surface p-0.5 rounded transition-colors\" onclick=\"document.getElementById('authAlert').classList.add('hidden')\" title=\"Đóng thông báo\" type=\"button\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px]\"\u003eclose\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c!-- Login Form --\u003e\n\u003cform class=\"space-y-4\" id=\"fanfunLoginForm\" onsubmit=\"event.preventDefault(); triggerAuthSim();\"\u003e\n\u003c!-- Email / Username Field --\u003e\n\u003cdiv class=\"space-y-1.5 text-left\"\u003e\n\u003clabel class=\"block font-label-md text-label-md text-on-surface\" for=\"loginId\"\u003e\n                Email hoặc Tên đăng nhập \u003cspan class=\"text-primary\"\u003e*\u003c/span\u003e\n\u003c/label\u003e\n\u003cdiv class=\"relative\"\u003e\n\u003cspan class=\"material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-[20px] text-tertiary\"\u003eperson\u003c/span\u003e\n\u003cinput class=\"w-full h-12 pl-11 pr-4 rounded-lg bg-surface-container-lowest text-on-surface font-body-md text-body-md placeholder:text-outline outline-none shadow-sm focus:shadow-md transition-all\" id=\"loginId\" name=\"loginId\" placeholder=\"vidu@fanfun.vn hoặc số điện thoại\" required=\"\" type=\"text\" value=\"nguyen.van@fanfun.vn\"\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Password Field --\u003e\n\u003cdiv class=\"space-y-1.5 text-left\"\u003e\n\u003clabel class=\"block font-label-md text-label-md text-on-surface\" for=\"passwordInput\"\u003e\n                Mật khẩu \u003cspan class=\"text-primary\"\u003e*\u003c/span\u003e\n\u003c/label\u003e\n\u003cdiv class=\"relative\"\u003e\n\u003cspan class=\"material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-[20px] text-tertiary\"\u003elock\u003c/span\u003e\n\u003cinput class=\"w-full h-12 pl-11 pr-11 rounded-lg bg-surface-container-lowest text-on-surface font-body-md text-body-md placeholder:text-outline outline-none shadow-sm focus:shadow-md transition-all\" id=\"passwordInput\" name=\"password\" placeholder=\"••••••••\" required=\"\" type=\"password\" value=\"12345678\"\u003e\n\u003cbutton class=\"absolute right-3.5 top-1/2 -translate-y-1/2 text-tertiary hover:text-on-surface transition-colors p-1\" id=\"togglePasswordBtn\" onclick=\"togglePasswordVisibility()\" title=\"Hiện/ẩn mật khẩu\" type=\"button\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[20px]\" id=\"pwdEyeIcon\"\u003evisibility\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Helper Row: Remember Me & Forgot Password --\u003e\n\u003cdiv class=\"flex items-center justify-between pt-1\"\u003e\n\u003clabel class=\"flex items-center gap-2 cursor-pointer select-none group\"\u003e\n\u003cdiv class=\"relative flex items-center justify-center\"\u003e\n\u003cinput checked=\"\" class=\"peer sr-only\" id=\"rememberMe\" type=\"checkbox\"\u003e\n\u003cdiv class=\"w-5 h-5 rounded bg-surface-container-lowest peer-checked:bg-primary transition-all flex items-center justify-center shadow-sm\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px] text-on-primary scale-0 peer-checked:scale-100 transition-transform font-bold\"\u003echeck\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cspan class=\"font-body-sm text-body-sm text-on-surface-variant group-hover:text-on-surface transition-colors\"\u003e\n                  Ghi nhớ đăng nhập\n                \u003c/span\u003e\n\u003c/label\u003e\n\u003ca class=\"font-label-sm text-label-sm text-primary hover:text-on-primary-fixed-variant transition-colors\" href=\"#forgot-password\"\u003e\n                Quên mật khẩu?\n              \u003c/a\u003e\n\u003c/div\u003e\n\u003c!-- Primary Action Button --\u003e\n\u003cdiv class=\"pt-2\"\u003e\n\u003cbutton class=\"w-full h-12 flex items-center justify-center gap-2 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg shadow-md hover:bg-primary-container active:scale-[0.99] transition-all\" id=\"submitLoginBtn\" type=\"submit\"\u003e\n\u003cspan\u003eĐăng nhập\u003c/span\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px]\"\u003earrow_forward\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c!-- Live State Demo Switch (Interactive Loading Preview) --\u003e\n\u003cdiv class=\"flex items-center justify-end gap-2 pt-0.5\"\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-tertiary\"\u003eMô phỏng trạng thái:\u003c/span\u003e\n\u003cbutton class=\"px-2.5 py-1 rounded bg-surface-container text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm transition-colors\" onclick=\"toggleLoadingState()\" type=\"button\"\u003e\n\u003cspan id=\"demoToggleLabel\"\u003eXem \"Đang xác thực...\"\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c/form\u003e\n\u003c!-- Social / Fast Login Divider --\u003e\n\u003cdiv class=\"relative py-2 flex items-center justify-center\"\u003e\n\u003cdiv class=\"absolute inset-0 flex items-center\"\u003e\n\u003cdiv class=\"w-full h-[1px] bg-outline-variant/60\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cspan class=\"relative px-3 bg-surface-container-low font-label-sm text-label-sm text-secondary uppercase tracking-wider\"\u003e\n              Hoặc đăng nhập nhanh bằng\n            \u003c/span\u003e\n\u003c/div\u003e\n\u003c!-- Fast Login Social Buttons --\u003e\n\u003cdiv class=\"grid grid-cols-2 gap-3\"\u003e\n\u003cbutton class=\"h-11 px-4 rounded-lg bg-surface-container-lowest text-on-surface hover:bg-surface-container transition-all flex items-center justify-center gap-2.5 font-label-md text-label-md shadow-sm\" type=\"button\"\u003e\n\u003csvg class=\"w-4 h-4\" viewBox=\"0 0 24 24\"\u003e\n\u003cpath d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\" fill=\"#4285F4\"\u003e\u003c/path\u003e\n\u003cpath d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\" fill=\"#34A853\"\u003e\u003c/path\u003e\n\u003cpath d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z\" fill=\"#FBBC05\"\u003e\u003c/path\u003e\n\u003cpath d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z\" fill=\"#EA4335\"\u003e\u003c/path\u003e\n\u003c/svg\u003e\n\u003cspan\u003eGoogle\u003c/span\u003e\n\u003c/button\u003e\n\u003cbutton class=\"h-11 px-4 rounded-lg bg-surface-container-lowest text-on-surface hover:bg-surface-container transition-all flex items-center justify-center gap-2.5 font-label-md text-label-md shadow-sm\" type=\"button\"\u003e\n\u003csvg class=\"w-4 h-4 fill-current\" viewBox=\"0 0 24 24\"\u003e\n\u003cpath d=\"M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.42c.62-.75 1.04-1.8 0.92-2.85-.9.04-1.98.6-2.61 1.34-.56.64-1.05 1.71-.92 2.73 1 .08 2-.47 2.61-1.22z\"\u003e\u003c/path\u003e\n\u003c/svg\u003e\n\u003cspan\u003eApple\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c!-- Bottom Switch to Register CTA --\u003e\n\u003cdiv class=\"text-center pt-2\"\u003e\n\u003cp class=\"font-body-sm text-body-sm text-on-surface-variant\"\u003e\n              Chưa có tài khoản FANFUN? \n              \u003ca class=\"font-label-md text-label-md text-primary font-bold hover:underline ml-1\" href=\"#register\"\u003e\n                Đăng ký ngay\n              \u003c/a\u003e\n\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Customer Security & Trust Badges Footer --\u003e\n\u003cdiv class=\"w-full max-w-md mx-auto pt-6 mt-6 border-t border-outline-variant/40 flex flex-col sm:flex-row items-center justify-between gap-3 text-secondary font-label-sm text-label-sm\"\u003e\n\u003cdiv class=\"flex items-center gap-1.5\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px] text-tertiary\"\u003elock\u003c/span\u003e\n\u003cspan\u003eBảo mật chuẩn SSL 256-bit\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex items-center gap-1.5\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px] text-tertiary\"\u003eshield\u003c/span\u003e\n\u003cspan\u003eCam kết bảo vệ thông tin\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cscript\u003e\n  let isPasswordVisible = false;\n  let isLoadingSimulation = false;\n\n  function togglePasswordVisibility() {\n    const passwordInput = document.getElementById('passwordInput');\n    const eyeIcon = document.getElementById('pwdEyeIcon');\n    if (!passwordInput || !eyeIcon) return;\n\n    isPasswordVisible = !isPasswordVisible;\n    if (isPasswordVisible) {\n      passwordInput.type = 'text';\n      eyeIcon.textContent = 'visibility_off';\n    } else {\n      passwordInput.type = 'password';\n      eyeIcon.textContent = 'visibility';\n    }\n  }\n\n  function toggleLoadingState() {\n    isLoadingSimulation = !isLoadingSimulation;\n    updateButtonVisualState(isLoadingSimulation);\n  }\n\n  function triggerAuthSim() {\n    updateButtonVisualState(true);\n    setTimeout(() =\u003e {\n      updateButtonVisualState(false);\n      const alertBox = document.getElementById('authAlert');\n      if (alertBox) {\n        alertBox.classList.remove('hidden');\n      }\n    }, 1200);\n  }\n\n  function updateButtonVisualState(loading) {\n    const btn = document.getElementById('submitLoginBtn');\n    const toggleLabel = document.getElementById('demoToggleLabel');\n    if (!btn) return;\n\n    if (loading) {\n      btn.disabled = true;\n      btn.classList.add('opacity-80', 'cursor-not-allowed');\n      btn.innerHTML = `\n        \u003csvg class=\"animate-spin h-5 w-5 text-on-primary\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\"\u003e\n          \u003ccircle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"\u003e\u003c/circle\u003e\n          \u003cpath class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"\u003e\u003c/path\u003e\n        \u003c/svg\u003e\n        \u003cspan\u003eĐang xác thực...\u003c/span\u003e\n      `;\n      if (toggleLabel) toggleLabel.textContent = 'Quay về mặc định';\n    } else {\n      btn.disabled = false;\n      btn.classList.remove('opacity-80', 'cursor-not-allowed');\n      btn.innerHTML = `\n        \u003cspan\u003eĐăng nhập\u003c/span\u003e\n        \u003cspan class=\"material-symbols-outlined text-[18px]\"\u003earrow_forward\u003c/span\u003e\n      `;\n      if (toggleLabel) toggleLabel.textContent = 'Xem \"Đang xác thực...\"';\n    }\n  }\n\u003c/script\u003e\u003c/main\u003e\n\n\u003c/body\u003e\u003c/html\u003e"
}
