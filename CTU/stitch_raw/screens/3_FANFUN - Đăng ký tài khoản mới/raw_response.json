  "dataString": "\u003c!DOCTYPE html\u003e\n\n\u003chtml lang=\"vi\"\u003e\u003chead\u003e\u003cmeta charset=\"utf-8\"/\u003e\u003cmeta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/\u003e\u003cmeta content=\"web_blank\" name=\"shell-type\"/\u003e\u003clink href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/\u003e\u003clink crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/\u003e\u003clink href=\"https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/\u003e\u003clink href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/\u003e\u003cstyle\u003e@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main\u003e:first-child{margin-top:0!important;}main\u003e:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}\u003c/style\u003e\u003cscript src=\"https://cdn.tailwindcss.com\"\u003e\u003c/script\u003e\u003cscript id=\"tailwind-config\"\u003etailwind.config={darkMode:\"class\",theme:{extend:{colors:{\"surface-variant\":\"#eae1d6\",\"on-primary-container\":\"#fffbff\",\"inverse-surface\":\"#343028\",\"on-surface\":\"#1f1b14\",\"on-primary\":\"#ffffff\",\"surface\":\"#fff8f2\",\"inverse-on-surface\":\"#f9efe4\",\"on-tertiary-fixed\":\"#1d1b15\",\"surface-container-highest\":\"#eae1d6\",\"on-secondary\":\"#ffffff\",\"on-secondary-container\":\"#656464\",\"error\":\"#ba1a1a\",\"background\":\"#fff8f2\",\"primary\":\"#9c3f11\",\"secondary\":\"#5f5e5e\",\"on-tertiary-fixed-variant\":\"#49473f\",\"tertiary\":\"#5f5c53\",\"tertiary-fixed-dim\":\"#cbc6bc\",\"on-surface-variant\":\"#56423b\",\"on-tertiary-container\":\"#fffbff\",\"on-tertiary\":\"#ffffff\",\"on-secondary-fixed-variant\":\"#474746\",\"on-primary-fixed-variant\":\"#7e2c00\",\"surface-container-lowest\":\"#ffffff\",\"on-secondary-fixed\":\"#1b1c1c\",\"error-container\":\"#ffdad6\",\"secondary-fixed\":\"#e4e2e1\",\"outline\":\"#8a7269\",\"surface-container-high\":\"#f0e7db\",\"surface-tint\":\"#9f4113\",\"tertiary-container\":\"#78746b\",\"on-primary-fixed\":\"#370e00\",\"outline-variant\":\"#ddc1b6\",\"primary-fixed-dim\":\"#ffb598\",\"primary-container\":\"#bc5728\",\"on-error\":\"#ffffff\",\"on-background\":\"#1f1b14\",\"surface-container\":\"#f6ede1\",\"surface-container-low\":\"#fcf2e7\",\"primary-fixed\":\"#ffdbce\",\"on-error-container\":\"#93000a\",\"surface-dim\":\"#e2d9ce\",\"surface-bright\":\"#fff8f2\",\"inverse-primary\":\"#ffb598\",\"tertiary-fixed\":\"#e8e2d7\",\"secondary-fixed-dim\":\"#c8c6c5\"},borderRadius:{DEFAULT:\"0.25rem\",lg:\"0.5rem\",xl:\"0.75rem\",full:\"9999px\"},spacing:{\"space-xs\":\"0.25rem\",\"space-lg\":\"1.5rem\",\"space-sm\":\"0.5rem\",\"gutter-mobile\":\"1rem\",gutter:\"1.5rem\",\"space-md\":\"1rem\",\"margin-mobile\":\"1.25rem\",\"space-xl\":\"2.5rem\",margin:\"3rem\"},fontFamily:{\"label-lg\":[\"Be Vietnam Pro\"],\"body-sm\":[\"Be Vietnam Pro\"],\"headline-md\":[\"Be Vietnam Pro\"],\"body-lg\":[\"Be Vietnam Pro\"],\"display-mobile\":[\"Be Vietnam Pro\"],\"label-md\":[\"Be Vietnam Pro\"],\"body-md\":[\"Be Vietnam Pro\"],\"headline-lg\":[\"Be Vietnam Pro\"],\"headline-lg-mobile\":[\"Be Vietnam Pro\"],\"headline-sm\":[\"Be Vietnam Pro\"],\"label-sm\":[\"Be Vietnam Pro\"],display:[\"Be Vietnam Pro\"]},fontSize:{\"label-lg\":[\"0.875rem\",{lineHeight:\"1.25rem\",letterSpacing:\"0.02em\",fontWeight:\"600\"}],\"body-sm\":[\"0.875rem\",{lineHeight:\"1.25rem\",letterSpacing:\"0.005em\",fontWeight:\"400\"}],\"headline-md\":[\"1.5rem\",{lineHeight:\"2rem\",letterSpacing:\"-0.01em\",fontWeight:\"600\"}],\"body-lg\":[\"1.125rem\",{lineHeight:\"1.75rem\",letterSpacing:\"0\",fontWeight:\"400\"}],\"display-mobile\":[\"2.25rem\",{lineHeight:\"2.75rem\",letterSpacing:\"-0.015em\",fontWeight:\"700\"}],\"label-md\":[\"0.75rem\",{lineHeight:\"1rem\",letterSpacing:\"0.04em\",fontWeight:\"600\"}],\"body-md\":[\"1rem\",{lineHeight:\"1.5rem\",letterSpacing:\"0\",fontWeight:\"400\"}],\"headline-lg\":[\"2.25rem\",{lineHeight:\"2.75rem\",letterSpacing:\"-0.015em\",fontWeight:\"600\"}],\"headline-lg-mobile\":[\"1.75rem\",{lineHeight:\"2.25rem\",letterSpacing:\"-0.01em\",fontWeight:\"600\"}],\"headline-sm\":[\"1.25rem\",{lineHeight:\"1.75rem\",letterSpacing:\"0\",fontWeight:\"600\"}],\"label-sm\":[\"0.6875rem\",{lineHeight:\"0.875rem\",letterSpacing:\"0.05em\",fontWeight:\"500\"}],display:[\"3.5rem\",{lineHeight:\"4.25rem\",letterSpacing:\"-0.02em\",fontWeight:\"700\"}]}}}};\u003c/script\u003e\u003c/head\u003e\u003cbody class=\"bg-surface font-body-md text-on-surface antialiased\"\u003e\u003cmain class=\"w-full min-h-screen flex items-center justify-center p-gutter-mobile md:p-gutter\"\u003e\u003cdiv class=\"flex flex-col w-full\"\u003e\n\u003cdiv class=\"w-full max-w-[1440px] mx-auto min-h-[920px] bg-surface rounded-xl shadow-xl overflow-hidden my-auto\"\u003e\n\u003cdiv class=\"grid grid-cols-1 lg:grid-cols-12 min-h-[920px]\"\u003e\n\u003c!-- Left Column: Brand & Member Privilege Showcase (~48% -\u003e 5 cols on lg, or 5/12) --\u003e\n\u003cdiv class=\"relative lg:col-span-5 hidden lg:flex flex-col justify-between p-10 bg-surface-container overflow-hidden\"\u003e\n\u003c!-- Living Room Imagery Scrim / Background --\u003e\n\u003cdiv class=\"absolute inset-0 bg-cover bg-center\" data-alt=\"Sunlit high-end Vietnamese modern apartment living room featuring natural oak furniture, warm beige linen sofa, lush balcony greenery, and an elegant smart matte ceiling fan gently rotating with ambient ceiling light glow in terracotta and sand hues.\" style=\"background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDscuNrOrgpLU6eNsAOBH56Rft2YBBoIs0jFhqBNoa9DMw5x79kwZC0XP48BIHHnk3jKqcQkW0mutq4JRtyon4U5pK7op-YJTJzz807F2o0EuDPkBc3YfSqge612_2og3rKCFyMnqraKCtLeonYi6m-XOtSlXINa7Yo_1S3vTfcTusufZ1Bs896Iu46UbqTZ69UAcJ_FBRkWlxIu7He6RA9BPdxMejRnRy6RrGwf0U')\"\u003e\n\u003c/div\u003e\n\u003c!-- Subtle layered gradient overlay for contrast --\u003e\n\u003cdiv class=\"absolute inset-0 bg-gradient-to-t from-inverse-surface/90 via-inverse-surface/40 to-inverse-surface/60\"\u003e\u003c/div\u003e\n\u003c!-- Top Member Badge & Accent Tag --\u003e\n\u003cdiv class=\"relative z-10 flex items-center justify-between\"\u003e\n\u003cdiv class=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface/90 backdrop-blur-md text-on-surface shadow-sm\"\u003e\n\u003cspan class=\"material-symbols-outlined text-primary text-[18px]\" style=\"font-variation-settings: 'FILL' 1;\"\u003estars\u003c/span\u003e\n\u003cspan class=\"font-label-sm text-label-sm tracking-wider uppercase font-semibold\"\u003eGia nhập cộng đồng FANFUN\u003c/span\u003e\n\u003c/div\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-surface-container-low/80 tracking-widest\"\u003eECOSYSTEM v2.4\u003c/span\u003e\n\u003c/div\u003e\n\u003c!-- Center Showcase: Privilege Points Card Overlay --\u003e\n\u003cdiv class=\"relative z-10 my-auto py-8\"\u003e\n\u003cdiv class=\"bg-inverse-surface/85 backdrop-blur-md p-7 rounded-xl shadow-2xl text-inverse-on-surface\"\u003e\n\u003cdiv class=\"inline-flex items-center gap-1.5 text-primary-fixed mb-2\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\"\u003everified\u003c/span\u003e\n\u003cspan class=\"font-label-md text-label-md uppercase tracking-wider\"\u003eĐặc quyền thành viên FANFUN\u003c/span\u003e\n\u003c/div\u003e\n\u003ch2 class=\"font-headline-md text-headline-md font-bold text-white mb-6 leading-snug\"\u003e\n              Khởi đầu không gian sống thông minh &amp; trọn vẹn\n            \u003c/h2\u003e\n\u003c!-- Value Proposition List --\u003e\n\u003cul class=\"space-y-4\"\u003e\n\u003cli class=\"flex items-start gap-3.5\"\u003e\n\u003cdiv class=\"w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center shrink-0 mt-0.5 text-primary-fixed\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px]\"\u003everified_user\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch4 class=\"font-label-lg text-label-lg text-white font-medium\"\u003eBảo hành chính hãng 5 năm\u003c/h4\u003e\n\u003cp class=\"font-body-sm text-body-sm text-surface-variant/80\"\u003eKích hoạt bảo hành điện tử chính hãng 1-chạm toàn quốc.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/li\u003e\n\u003cli class=\"flex items-start gap-3.5\"\u003e\n\u003cdiv class=\"w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center shrink-0 mt-0.5 text-primary-fixed\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px]\"\u003eredeem\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch4 class=\"font-label-lg text-label-lg text-white font-medium\"\u003eƯu đãi 300.000đ thành viên mới\u003c/h4\u003e\n\u003cp class=\"font-body-sm text-body-sm text-surface-variant/80\"\u003eTặng ngay voucher trực tiếp cho đơn hàng gia dụng đầu tiên.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/li\u003e\n\u003cli class=\"flex items-start gap-3.5\"\u003e\n\u003cdiv class=\"w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center shrink-0 mt-0.5 text-primary-fixed\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px]\"\u003ehome_repair_service\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch4 class=\"font-label-lg text-label-lg text-white font-medium\"\u003eKhảo sát &amp; Lắp đặt miễn phí\u003c/h4\u003e\n\u003cp class=\"font-body-sm text-body-sm text-surface-variant/80\"\u003eKỹ thuật viên cao cấp hỗ trợ tận nơi tại các thành phố lớn.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/li\u003e\n\u003cli class=\"flex items-start gap-3.5\"\u003e\n\u003cdiv class=\"w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center shrink-0 mt-0.5 text-primary-fixed\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px]\"\u003ecell_tower\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch4 class=\"font-label-lg text-label-lg text-white font-medium\"\u003eĐiều khiển FANFUN Smart\u003c/h4\u003e\n\u003cp class=\"font-body-sm text-body-sm text-surface-variant/80\"\u003eĐồng bộ kịch bản gió sinh học và cập nhật firmware liên tục.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Bottom Testimonial Quotation --\u003e\n\u003cdiv class=\"relative z-10 pt-4 bg-inverse-surface/60 backdrop-blur-md rounded-lg p-4\"\u003e\n\u003cdiv class=\"flex items-center gap-1 text-primary-fixed mb-1\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\"\u003estar\u003c/span\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\"\u003estar\u003c/span\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\"\u003estar\u003c/span\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\"\u003estar\u003c/span\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\"\u003estar\u003c/span\u003e\n\u003c/div\u003e\n\u003cp class=\"font-body-sm text-body-sm text-inverse-on-surface italic leading-relaxed\"\u003e\n            “Quạt FANFUN 3-in-1 êm ái vượt trội, dịch vụ hậu mãi rất chu đáo.”\n          \u003c/p\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-surface-variant font-medium mt-1 block\"\u003e\n            – Anh Tuấn, Masteri Thảo Điền\n          \u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Right Column: Registration Form (~52% -\u003e 7 cols on lg) --\u003e\n\u003cdiv class=\"lg:col-span-7 flex flex-col justify-between p-6 sm:p-10 lg:p-12 bg-surface overflow-y-auto\"\u003e\n\u003c!-- Header & Brand Top Bar --\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"flex items-center justify-between mb-8 pb-4\"\u003e\n\u003ca class=\"inline-flex items-center gap-3\" href=\"#\"\u003e\n\u003cimg alt=\"FANFUN Logo\" class=\"w-10 h-10 object-contain rounded-lg shadow-sm\" src=\"https://lh3.googleusercontent.com/aida/ALJJyrDMw-su0WMAGsmhG-uh3FUd8u9l-_ORj3SUA_mPhWoQE7QSIZuuDwaqFAxIC_6_nWy3LvEcjK-RVaLpoWJV4G1-qZ1gh76CZmzk1DqHSz4SYxYzYEnFCFEMAVu9VyHsZpOfbcLZV3QCTjL6aiQ30rT44hgBME0IkENoN1ulb4PaLfjM-tgahvzh3TJSr9d1LNzNpZH6hRO45AX2tcmjdiohxzMPoXNuQQ9EJR0sxeZp\"/\u003e\n\u003cdiv class=\"flex flex-col\"\u003e\n\u003cspan class=\"font-headline-sm text-headline-sm font-bold tracking-tight text-on-surface\"\u003eFANFUN\u003c/span\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest -mt-1\"\u003eSmart Living\u003c/span\u003e\n\u003c/div\u003e\n\u003c/a\u003e\n\u003cdiv class=\"text-right\"\u003e\n\u003cspan class=\"font-body-sm text-body-sm text-on-surface-variant\"\u003eĐã có tài khoản?\u003c/span\u003e\n\u003ca class=\"font-label-lg text-label-lg text-primary hover:text-primary-container font-semibold ml-1 transition-colors\" href=\"#\"\u003e\n                Đăng nhập ngay\n              \u003c/a\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Section Heading --\u003e\n\u003cdiv class=\"mb-6\"\u003e\n\u003ch1 class=\"font-headline-lg text-headline-lg font-bold text-on-surface tracking-tight mb-2\"\u003e\n              Tạo tài khoản mới\n            \u003c/h1\u003e\n\u003cp class=\"font-body-md text-body-md text-on-surface-variant\"\u003e\n              Trở thành thành viên FANFUN để tận hưởng dịch vụ chăm sóc khách hàng đặc quyền.\n            \u003c/p\u003e\n\u003c/div\u003e\n\u003c!-- Live Dynamic Registration Feedback Demo Banner --\u003e\n\u003cdiv class=\"mb-6 p-4 rounded-xl bg-surface-container-high shadow-sm flex items-start gap-3 transition-all duration-300\" id=\"statusToast\"\u003e\n\u003cspan class=\"material-symbols-outlined text-primary text-[22px] shrink-0 mt-0.5\"\u003emark_email_read\u003c/span\u003e\n\u003cdiv class=\"flex-1\"\u003e\n\u003ch5 class=\"font-label-lg text-label-lg text-on-surface font-semibold\"\u003eƯu đãi chào mừng đang sẵn sàng\u003c/h5\u003e\n\u003cp class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\"\u003e\n                Kích hoạt tài khoản nhận ngay mã giảm giá 300.000đ vào hòm thư.\n              \u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Form Area --\u003e\n\u003cform class=\"space-y-4\" id=\"registerForm\" onsubmit=\"event.preventDefault(); handleRegistrationSuccess();\"\u003e\n\u003c!-- Row: Họ và tên --\u003e\n\u003cdiv\u003e\n\u003clabel class=\"block font-label-lg text-label-lg text-on-surface mb-1.5\" for=\"fullName\"\u003e\n                Họ và tên \u003cspan class=\"text-primary\"\u003e*\u003c/span\u003e\n\u003c/label\u003e\n\u003cdiv class=\"relative\"\u003e\n\u003cspan class=\"material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]\"\u003e\n                  person\n                \u003c/span\u003e\n\u003cinput class=\"w-full h-12 pl-11 pr-10 rounded-lg bg-surface-container-lowest text-on-surface placeholder:text-on-surface-variant/60 font-body-md text-body-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:bg-surface-container-low transition-all\" id=\"fullName\" name=\"fullName\" placeholder=\"Nguyễn Văn A\" required=\"\" type=\"text\" value=\"Nguyễn Văn An\"/\u003e\n\u003cspan class=\"material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 text-tertiary-container text-[20px]\" title=\"Hợp lệ\"\u003e\n                  check_circle\n                \u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 2 Columns: Email & Phone --\u003e\n\u003cdiv class=\"grid grid-cols-1 md:grid-cols-2 gap-4\"\u003e\n\u003c!-- Email --\u003e\n\u003cdiv\u003e\n\u003clabel class=\"block font-label-lg text-label-lg text-on-surface mb-1.5\" for=\"email\"\u003e\n                  Địa chỉ Email \u003cspan class=\"text-primary\"\u003e*\u003c/span\u003e\n\u003c/label\u003e\n\u003cdiv class=\"relative\"\u003e\n\u003cspan class=\"material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]\"\u003e\n                    alternate_email\n                  \u003c/span\u003e\n\u003cinput class=\"w-full h-12 pl-11 pr-4 rounded-lg bg-surface-container-lowest text-on-surface placeholder:text-on-surface-variant/60 font-body-md text-body-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:bg-surface-container-low transition-all\" id=\"email\" name=\"email\" placeholder=\"tenban@example.com\" required=\"\" type=\"email\"/\u003e\n\u003c/div\u003e\n\u003cp class=\"font-label-sm text-label-sm text-on-surface-variant/80 mt-1 flex items-center gap-1\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[14px]\"\u003einfo\u003c/span\u003e\n                  Dùng để nhận hóa đơn và bảo hành điện tử\n                \u003c/p\u003e\n\u003c/div\u003e\n\u003c!-- Phone --\u003e\n\u003cdiv\u003e\n\u003clabel class=\"block font-label-lg text-label-lg text-on-surface mb-1.5\" for=\"phone\"\u003e\n                  Số điện thoại liên hệ \u003cspan class=\"text-primary\"\u003e*\u003c/span\u003e\n\u003c/label\u003e\n\u003cdiv class=\"relative\"\u003e\n\u003cspan class=\"material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]\"\u003e\n                    call\n                  \u003c/span\u003e\n\u003cinput class=\"w-full h-12 pl-11 pr-4 rounded-lg bg-surface-container-lowest text-on-surface placeholder:text-on-surface-variant/60 font-body-md text-body-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:bg-surface-container-low transition-all\" id=\"phone\" name=\"phone\" placeholder=\"0912 345 678\" required=\"\" type=\"tel\"/\u003e\n\u003c/div\u003e\n\u003cp class=\"font-label-sm text-label-sm text-on-surface-variant/80 mt-1\"\u003e\n                  Hỗ trợ thông báo giao hàng &amp; lắp đặt\n                \u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 2 Columns: Password & Confirm Password --\u003e\n\u003cdiv class=\"grid grid-cols-1 md:grid-cols-2 gap-4 pt-1\"\u003e\n\u003c!-- Password --\u003e\n\u003cdiv\u003e\n\u003clabel class=\"block font-label-lg text-label-lg text-on-surface mb-1.5\" for=\"password\"\u003e\n                  Mật khẩu \u003cspan class=\"text-primary\"\u003e*\u003c/span\u003e\n\u003c/label\u003e\n\u003cdiv class=\"relative\"\u003e\n\u003cspan class=\"material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]\"\u003e\n                    lock\n                  \u003c/span\u003e\n\u003cinput class=\"w-full h-12 pl-11 pr-11 rounded-lg bg-surface-container-lowest text-on-surface placeholder:text-on-surface-variant/60 font-body-md text-body-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:bg-surface-container-low transition-all\" id=\"password\" name=\"password\" placeholder=\"Tối thiểu 8 ký tự\" required=\"\" type=\"password\" value=\"SmartHome2024@\"/\u003e\n\u003cbutton aria-label=\"Ẩn hiện mật khẩu\" class=\"absolute right-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition-colors p-1\" onclick=\"togglePasswordVisibility('password', 'pwEyeIcon')\" type=\"button\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[20px]\" id=\"pwEyeIcon\"\u003evisibility\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c!-- Password Strength Meter --\u003e\n\u003cdiv class=\"mt-2\"\u003e\n\u003cdiv class=\"flex items-center justify-between mb-1\"\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-on-surface-variant\"\u003eĐộ mạnh mật khẩu:\u003c/span\u003e\n\u003cspan class=\"font-label-sm text-label-sm font-semibold text-primary\"\u003eKhá\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"grid grid-cols-3 gap-1.5 w-full\"\u003e\n\u003cdiv class=\"h-1.5 rounded-full bg-primary\"\u003e\u003c/div\u003e\n\u003cdiv class=\"h-1.5 rounded-full bg-primary\"\u003e\u003c/div\u003e\n\u003cdiv class=\"h-1.5 rounded-full bg-surface-variant\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Confirm Password --\u003e\n\u003cdiv\u003e\n\u003clabel class=\"block font-label-lg text-label-lg text-on-surface mb-1.5\" for=\"confirmPassword\"\u003e\n                  Xác nhận mật khẩu \u003cspan class=\"text-primary\"\u003e*\u003c/span\u003e\n\u003c/label\u003e\n\u003cdiv class=\"relative\"\u003e\n\u003cspan class=\"material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]\"\u003e\n                    lock_reset\n                  \u003c/span\u003e\n\u003cinput class=\"w-full h-12 pl-11 pr-11 rounded-lg bg-surface-container-lowest text-on-surface placeholder:text-on-surface-variant/60 font-body-md text-body-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:bg-surface-container-low transition-all\" id=\"confirmPassword\" name=\"confirmPassword\" placeholder=\"Nhập lại mật khẩu vừa tạo\" required=\"\" type=\"password\" value=\"SmartHome2024@\"/\u003e\n\u003cbutton aria-label=\"Ẩn hiện mật khẩu xác nhận\" class=\"absolute right-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition-colors p-1\" onclick=\"togglePasswordVisibility('confirmPassword', 'confirmPwEyeIcon')\" type=\"button\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[20px]\" id=\"confirmPwEyeIcon\"\u003evisibility\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c!-- Validation Feedback Indicator --\u003e\n\u003cdiv class=\"mt-2 flex items-center gap-1.5 text-tertiary-container\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px]\"\u003echeck_circle\u003c/span\u003e\n\u003cspan class=\"font-label-sm text-label-sm font-medium\"\u003eMật khẩu trùng khớp\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Terms & Consent Checkboxes --\u003e\n\u003cdiv class=\"pt-2 space-y-3\"\u003e\n\u003clabel class=\"flex items-start gap-3 cursor-pointer group\"\u003e\n\u003cinput checked=\"\" class=\"mt-1 w-4 h-4 rounded text-primary focus:ring-primary/40 cursor-pointer accent-primary\" required=\"\" type=\"checkbox\"/\u003e\n\u003cspan class=\"font-body-sm text-body-sm text-on-surface leading-snug\"\u003e\n                  Tôi đồng ý với \u003ca class=\"font-label-lg text-label-lg text-primary underline underline-offset-2 hover:text-primary-container\" href=\"#\"\u003eĐiều khoản dịch vụ\u003c/a\u003e và \u003ca class=\"font-label-lg text-label-lg text-primary underline underline-offset-2 hover:text-primary-container\" href=\"#\"\u003eChính sách bảo mật\u003c/a\u003e của FANFUN.\n                \u003c/span\u003e\n\u003c/label\u003e\n\u003clabel class=\"flex items-start gap-3 cursor-pointer group\"\u003e\n\u003cinput class=\"mt-1 w-4 h-4 rounded text-primary focus:ring-primary/40 cursor-pointer accent-primary\" type=\"checkbox\"/\u003e\n\u003cspan class=\"font-body-sm text-body-sm text-on-surface-variant leading-snug\"\u003e\n                  Nhận thông báo ưu đãi độc quyền, gợi ý thông gió thông minh và hướng dẫn sử dụng định kỳ qua email.\n                \u003c/span\u003e\n\u003c/label\u003e\n\u003c/div\u003e\n\u003c!-- Action Button --\u003e\n\u003cdiv class=\"pt-3\"\u003e\n\u003cbutton class=\"w-full h-12 bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-2 group active:scale-[0.99]\" type=\"submit\"\u003e\n\u003cspan\u003eĐăng ký tài khoản\u003c/span\u003e\n\u003cspan class=\"material-symbols-outlined text-[20px] group-hover:translate-x-1 transition-transform\"\u003e\n                  arrow_forward\n                \u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c/form\u003e\n\u003c/div\u003e\n\u003c!-- Trust and Encryption Guarantee Footer --\u003e\n\u003cdiv class=\"pt-6 mt-6 bg-transparent flex flex-col sm:flex-row items-center justify-between gap-4 text-on-surface-variant/80\"\u003e\n\u003cdiv class=\"flex items-center gap-2\"\u003e\n\u003cspan class=\"material-symbols-outlined text-primary text-[18px]\"\u003everified\u003c/span\u003e\n\u003cspan class=\"font-label-sm text-label-sm\"\u003e\n              Dữ liệu được mã hóa và bảo mật tuyệt đối theo tiêu chuẩn an toàn thông tin ISO/IEC 27001.\n            \u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex items-center gap-4 shrink-0\"\u003e\n\u003cspan class=\"font-label-sm text-label-sm hover:text-primary cursor-pointer transition-colors\"\u003eTrung tâm trợ giúp\u003c/span\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-surface-variant\"\u003e•\u003c/span\u003e\n\u003cspan class=\"font-label-sm text-label-sm hover:text-primary cursor-pointer transition-colors\"\u003eHotline 1900 6868\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cscript\u003e\n    function togglePasswordVisibility(inputId, iconId) {\n      const input = document.getElementById(inputId);\n      const icon = document.getElementById(iconId);\n      if (input.type === 'password') {\n        input.type = 'text';\n        icon.textContent = 'visibility_off';\n      } else {\n        input.type = 'password';\n        icon.textContent = 'visibility';\n      }\n    }\n\n    function handleRegistrationSuccess() {\n      const toast = document.getElementById('statusToast');\n      toast.className = 'mb-6 p-4 rounded-xl bg-primary-fixed text-on-primary-fixed shadow-md flex items-start gap-3 transition-all duration-300 transform scale-[1.01]';\n      toast.innerHTML = `\n        \u003cspan class=\"material-symbols-outlined text-primary text-[24px] shrink-0 mt-0.5\"\u003echeck_circle\u003c/span\u003e\n        \u003cdiv class=\"flex-1\"\u003e\n          \u003ch5 class=\"font-label-lg text-label-lg font-bold\"\u003eĐăng ký thành công!\u003c/h5\u003e\n          \u003cp class=\"font-body-sm text-body-sm mt-0.5\"\u003e\n            Vui lòng kiểm tra email kích hoạt tài khoản của bạn để nhận mã giảm giá 300.000đ.\n          \u003c/p\u003e\n        \u003c/div\u003e\n      `;\n    }\n  \u003c/script\u003e\n\u003c/div\u003e\u003c/main\u003e\u003c/body\u003e\u003c/html\u003e"
}
