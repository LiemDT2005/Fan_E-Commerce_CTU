uppercase mt-space-xs\"\u003eSmart Living\u003c/span\u003e\u003c/a\u003e\u003c/div\u003e\u003cnav class=\"hidden xl:flex items-center gap-space-xs\" data-active-classes=\"bg-primary-container text-on-primary-container font-semibold rounded-lg shadow-sm\"\u003e\u003ca class=\"px-space-md py-space-sm font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all\" data-path=\"trang-chu\" href=\"#\"\u003eTrang chủ\u003c/a\u003e\u003ca class=\"px-space-md py-space-sm font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all\" data-path=\"san-pham-he-sinh-thai\" href=\"#\"\u003eSản phẩm &amp; Hệ sinh thái\u003c/a\u003e\u003ca class=\"px-space-md py-space-sm font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all\" data-path=\"cong-nghe-3-in-1\" href=\"#\"\u003eCông nghệ 3-in-1\u003c/a\u003e\u003ca class=\"px-space-md py-space-sm font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all\" data-path=\"dich-vu-lap-dat-bao-hanh\" href=\"#\"\u003eDịch vụ lắp đặt &amp; Bảo hành\u003c/a\u003e\u003ca class=\"px-space-md py-space-sm font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all\" data-path=\"cau-chuyen-thuong-hieu\" href=\"#\"\u003eCâu chuyện thương hiệu\u003c/a\u003e\u003c/nav\u003e\u003cdiv class=\"flex items-center gap-space-md\"\u003e\u003cbutton aria-label=\"Tìm kiếm\" class=\"p-space-xs rounded-full text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all flex items-center justify-center\"\u003e\u003cspan class=\"material-symbols-outlined text-[22px]\"\u003esearch\u003c/span\u003e\u003c/button\u003e\u003ca class=\"hidden md:flex items-center gap-space-xs px-space-md py-space-sm rounded-full bg-surface-container-low hover:bg-surface-container transiti