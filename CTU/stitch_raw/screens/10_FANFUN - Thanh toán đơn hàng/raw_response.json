mbols-outlined text-primary text-[22px]\"\u003esupport_agent\u003c/span\u003e\n\u003cdiv class=\"flex flex-col\"\u003e\n\u003cspan class=\"font-label-md text-label-md font-semibold text-on-surface\"\u003eCần thay đổi thông số trần?\u003c/span\u003e\n\u003cspan class=\"font-body-sm text-body-sm text-on-surface-variant\"\u003eHotline kỹ sư 1900 6868\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003ca class=\"font-label-md text-label-md font-bold text-primary hover:underline\" href=\"tel:19006868\"\u003eGọi ngay\u003c/a\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Small Environmental & Craftsmanship Note --\u003e\n\u003cdiv class=\"px-space-sm flex items-center gap-space-xs text-on-surface-variant font-label-sm text-label-sm\"\u003e\n\u003cspan class=\"material-symbols-outlined text-primary text-[16px]\"\u003eeco\u003c/span\u003e\n\u003cspan\u003eCánh quạt làm từ gỗ óc chó tự nhiên được xử lý chống ẩm phù hợp khí hậu nồm ẩm Việt Nam.\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003c!-- Interactive JavaScript for micro-interactions & feedback simulation --\u003e\n\u003cscript\u003e\n    function simulateOrderProcessing() {\n      const btn = document.getElementById('confirm-checkout-btn');\n      const btnText = document.getElementById('btn-text');\n      const btnSpinner = document.getElementById('btn-spinner');\n      const banner = document.getElementById('order-success-banner');\n\n      if (!btn || !btnText || !btnSpinner || !banner) return;\n\n      // Toggle state to loading\n      btnText.classList.add('hidden');\n      btnText.classList.remove('flex');\n      btnSpinner.classList.remove('hidden');\n      btnSpinner.classList.add('flex');\n      btn.disabled = true;\n      btn.classList.add('opacity-80', 'cursor-not-allowed');\n\n      // Simulate confirmation resolution\n      setTimeout(() =\u003e {\n        btnSpinner.classList.add('hidden');\n        btnSpinner.classList.r